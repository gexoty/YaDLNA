FROM station-dlna-validator
RUN apt-get update && apt-get install -y --no-install-recommends libssl-dev:armhf libssl-dev:amd64 curl xz-utils make && rm -rf /var/lib/apt/lists/*
RUN mkdir /curl-src && curl -fsSL https://curl.se/download/curl-8.15.0.tar.xz | tar xJ -C /curl-src --strip-components=1
RUN cd /curl-src && mkdir /curl-arm /curl-host && cd /curl-arm && /curl-src/configure --host=arm-linux-gnueabihf --prefix=/opt/curl-arm --disable-shared --enable-static --disable-docs --disable-manual --disable-ldap --disable-ldaps --disable-ftp --disable-file --disable-rtsp --disable-dict --disable-telnet --disable-tftp --disable-pop3 --disable-imap --disable-smb --disable-smtp --disable-gopher --disable-mqtt --disable-websockets --disable-sspi --without-zlib --without-brotli --without-zstd --without-libidn2 --without-libpsl --without-libssh2 --without-nghttp2 --without-nghttp3 --without-ngtcp2 --with-openssl --enable-threaded-resolver --with-ca-bundle=/system/vendor/quasar/ca-certificates.crt CC=arm-linux-gnueabihf-gcc CFLAGS='-Os -ffunction-sections -fdata-sections' LDFLAGS='-L/usr/lib/arm-linux-gnueabihf' PKG_CONFIG_LIBDIR=/usr/lib/arm-linux-gnueabihf/pkgconfig && make -j4 -C lib && make -C lib install && make -C include install
RUN cd /curl-host && /curl-src/configure --prefix=/opt/curl-host --disable-shared --enable-static --disable-docs --disable-manual --disable-ldap --disable-ldaps --disable-ftp --disable-file --disable-rtsp --disable-dict --disable-telnet --disable-tftp --disable-pop3 --disable-imap --disable-smb --disable-smtp --disable-gopher --disable-mqtt --disable-websockets --without-zlib --without-brotli --without-zstd --without-libidn2 --without-libpsl --without-libssh2 --without-nghttp2 --without-nghttp3 --without-ngtcp2 --with-openssl --enable-threaded-resolver CFLAGS='-Os -ffunction-sections -fdata-sections' && make -j4 -C lib && make -C lib install && make -C include install
